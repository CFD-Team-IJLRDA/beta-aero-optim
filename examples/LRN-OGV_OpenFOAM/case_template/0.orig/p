FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

#include "include/operatingPoint"

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform $pOutlet;

boundaryField
{
    front   { type empty; }
    back    { type empty; }
    top     { type cyclicAMI; value $internalField; }
    bottom  { type cyclicAMI; value $internalField; }
    inlet   { type zeroGradient; }
    outlet
    {
        type            fixedValue;
        value           uniform $pOutlet;
    }
    airfoil { type zeroGradient; }
}
