FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    front   { type empty; }
    back    { type empty; }
    top     { type cyclicAMI; value $internalField; }
    bottom  { type cyclicAMI; value $internalField; }
    inlet   { type calculated; value $internalField; }
    outlet  { type calculated; value $internalField; }
    airfoil
    {
        type            nutkWallFunction;
        value           $internalField;
    }
}
