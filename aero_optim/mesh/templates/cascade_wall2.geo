// ====== Raffinement doux (ajouts / overrides) ======
lcScale = 1.0;         // facteur global si tu veux encore réduire/augmenter
H       = 1.0e-2;      // épaisseur d’extrusion (1 cellule en z)

// --- Affine le BL existant (maillage plus fin près de la pale) ---
Field[1].Size      = 7.500000e-06 * lcScale;   // avant: 5.0e-5
Field[1].SizeFar   = 3.5e-4 * lcScale;   // avant: 5.0e-4
Field[1].Thickness = 0.003;             // un peu plus compact que 0.004
Field[1].Ratio     = 1.058301; // progressivité plus douce (avant 1.15)

Field[2].VIn = 8.0e-4 * lcScale;
Field[2].VOut = 2.5e-3 * lcScale;

// ====== Raffine les divisions transfinies principales ======
// (On garde la topologie, on augmente seulement le nombre de nœuds)

Transfinite Curve{1}  = 23 Using Progression 1.009950;   // avant 8
Transfinite Curve{2}  = 127 Using Progression 1.014889;   // avant 42
Transfinite Curve{3}  = 127 Using Progression 1.000000;   // avant 42
Transfinite Curve{4}  = 39 Using Progression 0.969536;   // avant 14
Transfinite Curve{5}  = 23 Using Progression 0.984886;   // avant 8
Transfinite Curve{6}  = 23 Using Progression 1.012423;  // avant 8
Transfinite Curve{7}  = 171 Using Progression 1.007472;  // avant 57
Transfinite Curve{8}  = 95 Using Progression 0.977241;  // avant 32
Transfinite Curve{9}  = 23 Using Progression 0.948683;   // avant 8

// Contours externe (inlet / outlet / parois) – un peu plus de points
Transfinite Curve{10} = 37 Using Progression 1.0;    // avant 25
Transfinite Curve{11} = 45 Using Progression 1.0;    // avant 31
Transfinite Curve{12} = 45 Using Progression 1.0;    // avant 31
Transfinite Curve{13} = 37 Using Progression 1.0;    // avant 25
Transfinite Curve{14:19} = 9 Using Progression 1.0;  // avant 7
Transfinite Curve{23:28} = 9 Using Progression 1.0;  // avant 7
Transfinite Curve{20} = 47 Using Progression 1.0;    // avant 31
Transfinite Curve{22} = 47 Using Progression 1.0;    // avant 31
Transfinite Curve{21} = 25 Using Progression 1.0;    // avant 17

// Re-déclarer la surface transfinie si nécessaire (surface 1 déjà transfinie dans ton fichier)
Transfinite Surface{1};
Transfinite Surface{3};

out[] = Extrude {0, 0, H} { Surface{1}; Surface{2}; Surface{3}; Layers{1}; Recombine; };

// ====== Groupes physiques 3D ======
Physical Volume("fluid") = { out[1], out[7], out[38] };

Physical Surface("inlet")  = { out[2] };
Physical Surface("outlet") = { out[16] };

Physical Surface("bottom") = {out[5],out[9],out[10],out[11],out[12],out[13],out[14],out[15]};

Physical Surface("top") = {out[3],out[17],out[18],out[19],out[20],out[21],out[22],out[23]};

Physical Surface("airfoil") = { out[24], out[25], out[26], out[27],
    out[28], out[29], out[30], out[31], out[32] };

// Front (z=0) and back (z=H) faces
Physical Surface("front")  = { 1, 2, 3 };
Physical Surface("back") = { out[0], out[6], out[37] };

// Mesh optimization
Mesh.RecombineAll = 1;
Mesh.Optimize = 1;
Mesh.OptimizeNetgen = 1;
